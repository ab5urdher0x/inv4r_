# Copy to .env and fill in real values. Only required for production startup.
# Do not commit the resulting .env file.
INV4R_JWT_SECRET=replace-with-a-unique-32-character-or-longer-secret

# Dedicated secret for encrypting cloud LLM API keys at rest. Must be separate
# from INV4R_JWT_SECRET and at least 32 characters when cloud key storage is
# used (optional otherwise).
INV4R_SECRET_KEY=

# Directory holding encrypted secrets (gitignored). Defaults to ./secrets.
INV4R_SECRETS_DIR=secrets

INV4R_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
INV4R_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-12-character-password

# Leave empty for the same-origin dashboard served by INV4R. Add an exact,
# comma-separated origin only when deploying the dashboard separately.
INV4R_CORS_ORIGINS=
